{
  "name": "iptv-webclient",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "author": {
    "name": "ebrainte",
    "email": "ebrainte@users.noreply.github.com"
  },
  "description": "IPTV web client with Xtream Codes API support",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "electron:dev": "npm run build && electron electron.cjs",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.ebrainte.iptv-webclient",
    "productName": "IPTV Client",
    "files": [
      "dist/**/*",
      "server.js",
      "electron.cjs"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "hls.js": "^1.6.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  }
}
